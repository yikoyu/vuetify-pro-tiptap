{
  "name": "vuetify-pro-tiptap",
  "type": "module",
  "version": "3.0.0",
  "private": false,
  "packageManager": "pnpm@8.15.8",
  "description": "tiptap text editor on vuejs and vuetify",
  "author": "yikoyu<2282373181@qq.com>",
  "license": "MIT",
  "homepage": "https://yikoyu.github.io/vuetify-pro-tiptap/",
  "repository": {
    "type": "git",
    "url": "https://github.com/yikoyu/vuetify-pro-tiptap"
  },
  "keywords": [
    "vue",
    "vue.js",
    "typescript",
    "vuetify",
    "tiptap",
    "editor",
    "material design",
    "wysiwyg",
    "markdown"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/vuetify-pro-tiptap.js",
      "require": "./lib/vuetify-pro-tiptap.umd.cjs"
    },
    "./vuetify-pro-tiptap.css": {
      "import": "./lib/vuetify-pro-tiptap.css",
      "require": "./lib/vuetify-pro-tiptap.css"
    },
    "./styles/": {
      "import": "./lib/styles/",
      "require": "./lib/styles/"
    }
  },
  "main": "./lib/vuetify-pro-tiptap.umd.cjs",
  "module": "./lib/vuetify-pro-tiptap.js",
  "types": "./lib/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "lib",
    "package.json"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "watch-build": "nodemon --watch src -e ts,vue,scss --exec 'pnpm build:lib'",
    "build:lib": "pnpm check:types && vite build  && pnpm build:styles",
    "build:examples": "pnpm build:lib && pnpm check:types && vite build --config vite-example.config.ts",
    "build:styles": "pnpm sass ./src/styles:./lib/styles --style=compressed --no-source-map",
    "lint:css": "stylelint **/*.{css,less,scss,vue}",
    "lint:js": "eslint .",
    "lint:all": "eslint . & stylelint **/*.{css,less,scss,vue}",
    "lint:fix": "eslint . --fix & stylelint **/*.{css,less,scss,vue} --fix",
    "commit": "czg",
    "check:types": "vue-tsc --noEmit --skipLibCheck",
    "push": "pnpm build:lib && pnpm publish --no-git-checks --registry https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "vue": "^3.2.0",
    "vuetify": "^3.0.0"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-blockquote": "^3.32.2",
    "@tiptap/extension-bold": "^3.32.2",
    "@tiptap/extension-bullet-list": "^3.32.2",
    "@tiptap/extension-character-count": "^3.32.2",
    "@tiptap/extension-code": "^3.32.2",
    "@tiptap/extension-code-block": "^3.32.2",
    "@tiptap/extension-color": "^3.32.2",
    "@tiptap/extension-document": "^3.32.2",
    "@tiptap/extension-dropcursor": "^3.32.2",
    "@tiptap/extension-focus": "^3.32.2",
    "@tiptap/extension-font-family": "^3.32.2",
    "@tiptap/extension-gapcursor": "^3.32.2",
    "@tiptap/extension-hard-break": "^3.32.2",
    "@tiptap/extension-heading": "^3.32.2",
    "@tiptap/extension-highlight": "^3.32.2",
    "@tiptap/extension-history": "^3.32.2",
    "@tiptap/extension-horizontal-rule": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-italic": "^3.32.2",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extension-list-item": "^3.32.2",
    "@tiptap/extension-mention": "^3.32.2",
    "@tiptap/extension-ordered-list": "^3.32.2",
    "@tiptap/extension-paragraph": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/extension-strike": "^3.32.2",
    "@tiptap/extension-subscript": "^3.32.2",
    "@tiptap/extension-superscript": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-table-cell": "^3.32.2",
    "@tiptap/extension-table-header": "^3.32.2",
    "@tiptap/extension-table-row": "^3.32.2",
    "@tiptap/extension-task-item": "^3.32.2",
    "@tiptap/extension-task-list": "^3.32.2",
    "@tiptap/extension-text": "^3.32.2",
    "@tiptap/extension-text-align": "^3.32.2",
    "@tiptap/extension-text-style": "^3.32.2",
    "@tiptap/extension-underline": "^3.32.2",
    "@tiptap/html": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/vue-3": "^3.32.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.16.0",
    "@mdi/js": "^7.4.47",
    "@types/lodash": "^4.17.20",
    "@types/lodash-es": "^4.17.12",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vueuse/core": "^11.3.0",
    "@yikoyu/commitlint-config": "^0.2.2",
    "@yikoyu/semantic-release-config": "^0.1.4",
    "@yikoyu/stylelint-config": "^0.1.2",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "cz-git": "^1.12.0",
    "czg": "^1.12.0",
    "eslint": "^9.35.0",
    "eslint-plugin-format": "^0.1.3",
    "fs-extra": "^11.3.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "lodash-unified": "^1.0.3",
    "nodemon": "^3.1.10",
    "rollup": "^4.63.3",
    "rollup-plugin-pure": "^0.4.0",
    "sass": "^1.92.1",
    "semantic-release": "^24.2.8",
    "typescript": "5.5.4",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^7.3.6",
    "vite-plugin-checker": "^0.8.0",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.43",
    "vue-tsc": "2.1.6",
    "vuetify": "^3.10.1",
    "xss": "^1.0.15"
  },
  "pnpm": {
    "overrides": {
      "@cacheable/memory@2": "2.0.1",
      "@cacheable/utils@2": "2.0.1",
      "@humanfs/node@<0.16.8": "0.16.8",
      "ajv@6": "6.14.0",
      "ajv@8": "8.18.0",
      "baseline-browser-mapping@<2.11.0": "2.11.0",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@<1.1.18": "1.1.18",
      "browserslist@<4.28.7": "4.28.7",
      "cacheable@2": "2.0.1",
      "fast-uri@<3.1.6": "3.1.6",
      "flat-cache@6": "6.1.14",
      "flatted@<3.4.2": "3.4.2",
      "handlebars@<4.7.9": "4.7.9",
      "happy-dom@<21.0.4": "21.0.4",
      "immutable@5": "5.1.9",
      "js-yaml@<4.3.2": "4.3.2",
      "lodash-es@4": "4.18.1",
      "lodash@4": "4.18.1",
      "minimatch@10": "10.2.6",
      "minimatch@3": "3.1.5",
      "minimatch@9": "9.0.9",
      "nanoid@<3.3.18": "3.3.18",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.5",
      "postcss-selector-parser@6": "6.1.3",
      "postcss-selector-parser@7": "7.1.3",
      "postcss@<8.5.23": "8.5.23",
      "yaml@2": "2.8.3"
    }
  }
}
